# Arquivo de exemplo para variáveis de ambiente
# Copie este arquivo para .env e preencha com seus próprios valores

# Banco de Dados (PostgreSQL)
DB_HOST=localhost            # Endereço do servidor PostgreSQL
DB_PORT=5432                 # Porta do PostgreSQL 
DB_USERNAME=postgres         # Usuário do banco
DB_PASSWORD=                 # Senha do banco
DB_NAME=                     # Nome do banco de dados

# Redis (para cache)         
REDIS_HOST=localhost         # Endereço do servidor Redis
REDIS_PORT=6379              # Porta do Redis (padrão: 6379)
REDIS_PASSWORD=              # Senha do Redis (opcional)
REDIS_DB=0                   # Número do banco Redis (opcional)
REDIS_TTL=3600               # TTL padrão para dados gerais

# Autenticação (JWT)
JWT_SECRET=                  # Chave secreta pra token

# Serviço de Email (para envio das cartas)
# Use um serviço como SendGrid, Mailgun, ou uma conta Gmail com "senha de app"
EMAIL_HOST=smtp.gmail.com                 # Servidor SMTP
EMAIL_PORT=587                            # Porta SMTP (587 para TLS)
EMAIL_SECURE=false                        # true para SSL, false para TLS
EMAIL_USER=seu-email@gmail.com            # Usuario
EMAIL_PASS=sua_senha_de_app_do_email      # Senha

# Webhook do Zapier (para integração)
ZAPIER_WEBHOOK_URL=                     # URL do Zapier pra enviar dados das solicitações, default é o que foi passado

# Geração do PDF - deixamos para tornar mais dinâmica a configuração
PDF_CACHE_TTL=                          # Tempo de vida do cache de PDF (segundos)
TEMPLATE_CACHE_TTL=                     # Tempo de vida do cache de templates (segundos)